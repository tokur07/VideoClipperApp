<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Video Clipper Pro"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- BAGIAN 1: SUMBER VIDEO -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. Sumber Video (Galeri / YouTube / Stream)"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnPickVideo"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Pilih Video dari Galeri HP" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etStreamUrl"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Link YouTube / TikTok / .mp4 / .m3u8"
                        android:inputType="textUri"
                        android:maxLines="1" />

                    <Button
                        android:id="@+id/btnLoadUrl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Muat" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvVideoInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Belum ada video dimuat (atau bagikan link dari YouTube)"
                    android:textSize="13sp" />

                <androidx.media3.ui.PlayerView
                    android:id="@+id/playerView"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="10dp"
                    android:visibility="gone"
                    app:use_controller="true" />

                <LinearLayout
                    android:id="@+id/layoutResolution"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kualitas Unduh: "
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spResolution"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- BAGIAN 2: MODE & WAKTU POTONG -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2. Mode &amp; Waktu Pemotongan (JJ:MM:DD)"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgClipMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp">

                    <RadioButton
                        android:id="@+id/rbSingle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Single Trim (1 Klip Spesifik)" />

                    <RadioButton
                        android:id="@+id/rbBatch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Batch Multi-Timestamp (Banyak Klip Sekaligus)" />

                    <RadioButton
                        android:id="@+id/rbAutoSplit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Auto-Split Series (Pecah Otomatis per N Detik)" />
                </RadioGroup>

                <!-- Panel Single Trim -->
                <LinearLayout
                    android:id="@+id/panelSingle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/etStartTime"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Mulai (00:00:00)"
                            android:inputType="time"
                            android:text="00:00:00" />

                        <EditText
                            android:id="@+id/etEndTime"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:hint="Selesai (00:00:30)"
                            android:inputType="time"
                            android:text="00:00:30" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnSetStartFromPlayer"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Mulai = Posisi Video"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/btnSetEndFromPlayer"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="Selesai = Posisi Video"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Panel Batch Multi-Timestamp -->
                <LinearLayout
                    android:id="@+id/panelBatch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/etBatchTimestamps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:hint="Contoh per baris:\n00:01:15-00:01:45\n00:05:10-00:05:50"
                        android:inputType="textMultiLine"
                        android:minLines="3" />
                </LinearLayout>

                <!-- Panel Auto-Split -->
                <LinearLayout
                    android:id="@+id/panelAutoSplit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/etSplitSec"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Durasi per part (detik, misal: 60)"
                        android:inputType="number"
                        android:text="60" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- BAGIAN 3: TATA LETAK LAYAR -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3. Tata Letak Layar (Shorts / TikTok / Reels)"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgAspectLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp">

                    <RadioButton
                        android:id="@+id/rbLayoutBlurBg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="9:16 Fit + Blurred Background (Cocok Podcast/Gaming)" />

                    <RadioButton
                        android:id="@+id/rbLayoutCrop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="9:16 Full Center Crop (Potong Sisi Kiri-Kanan)" />

                    <RadioButton
                        android:id="@+id/rbLayoutOriginal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rasio Asli (Tanpa Ubah Ukuran)" />
                </RadioGroup>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- BAGIAN 4: TEKS AUTO & MANUAL -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4. Teks Auto &amp; Manual (Safe-Zone TikTok/Reels)"
                    android:textStyle="bold" />

                <!-- Auto & Manual Subtitle -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swAutoSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Auto-Subtitle (Ambil CC / Transkrip YouTube)" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnPickSrt"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Impor .SRT Manual"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvSrtStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="Tidak ada file .srt manual"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Hook / Header Text -->
                <EditText
                    android:id="@+id/etHookTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="Teks Judul / Hook Atas (Opsional)"
                    android:inputType="textCapSentences" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swAutoPartNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Auto-Nomor Part di Judul (saat Auto-Split)" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gaya Judul: " />

                    <Spinner
                        android:id="@+id/spHookStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
                </LinearLayout>

                <!-- Watermark -->
                <EditText
                    android:id="@+id/etWatermark"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="Teks Watermark (misal: @channelkamu)"
                    android:inputType="text" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Posisi Watermark: " />

                    <Spinner
                        android:id="@+id/spWatermarkPos"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- TOMBOL EKSEKUSI -->
        <Button
            android:id="@+id/btnStartClip"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            android:enabled="false"
            android:text="Mulai Potong &amp; Render (Background)"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:max="100"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text=""
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnUpdateYtDlp"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="24dp"
            android:text="Update Engine yt-dlp" />

    </LinearLayout>
</ScrollView>
